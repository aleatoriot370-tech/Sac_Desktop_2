# SAC - Grupo Lamoia
# Copie este arquivo para .env e preencha os valores.

# --- Supabase (banco principal) ---
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
# Opcional: se preenchida, ignora RLS (use com cuidado)
SUPABASE_SERVICE_KEY=

# --- Postgres externo (somente leitura, para importação de valores) ---
# Deixe em branco para desabilitar a consulta ao banco externo
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_NAME=
EXTERNAL_DB_USER=
EXTERNAL_DB_PASSWORD=
# sslmode: disable, prefer (padrão), require, verify-ca, verify-full
EXTERNAL_DB_SSLMODE=prefer

# --- Armazenamento de mídia ---
# Pasta definitiva onde as mídias do SAC ficam armazenadas
MEDIA_PATH=P:\ANÁLISE DE VENDAS\Jamerson\Mídia Sac
# Pasta de origem usada pela rotina de integração (1.4.1)
MEDIA_STAGING_PATH=G:\Meu Drive\Sistema Sac\Midia
