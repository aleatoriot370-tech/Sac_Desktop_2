# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" real para um repositório público.

# Supabase (banco principal)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=coloque_a_chave_anon_aqui

# OPCIONAL: chave "service_role" do Supabase (Project Settings > API).
# Se preenchida, o app passa a usar ESTA chave em vez da anon key acima,
# o que faz TODAS as operações do app ignorarem o RLS (Row Level Security)
# das tabelas. Use isso se você tiver RLS ativado nas tabelas mas não
# quiser configurar policies liberando acesso para o role "anon" — é a
# forma mais rápida de resolver erros como
# "new row violates row-level security policy for table ...".
# Se preferir manter o RLS ativo e seguro, deixe esta linha vazia e
# configure policies de INSERT/UPDATE/SELECT/DELETE para o role "anon"
# em cada tabela usada pelo app (veja o README para o SQL sugerido).
# ATENÇÃO: a service_role key dá acesso TOTAL ao banco, sem nenhuma
# restrição. Trate-a como uma senha de administrador.
SUPABASE_SERVICE_KEY=

# Postgres externo (importação de valores - somente leitura)
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_NAME=
EXTERNAL_DB_USER=
EXTERNAL_DB_PASSWORD=
# 'prefer' (padrão), ou 'require' se seu provedor exigir SSL
EXTERNAL_DB_SSLMODE=prefer

# Caminhos de mídia
MEDIA_PATH=P:\ANÁLISE DE VENDAS\Jamerson\Mídia Sac
MEDIA_STAGING_PATH=G:\Meu Drive\Sistema Sac\Midia
